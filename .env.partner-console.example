# Copy this file to .env.partner-console.local and fill in the real key.
# The local file is ignored by git via the existing .env.*.local rule.

PARTNER_BASE_URL=https://anthropic-api.com
PARTNER_API_KEY=

# Positive checks
PARTNER_OPENAI_MODEL=claude-sonnet-4-6
PARTNER_ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional negative check. Leave empty to skip.
PARTNER_NEGATIVE_MODEL=gpt-4o
